            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="lc:fails_to_pay_support"/>
              <ruleml:Var type="lc:defendant">Defendant</ruleml:Var>
              <ruleml:Data xsi:type="xs:string">true</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom>
                <ruleml:Rel iri="lc:justified_reasons_for_nonpayment"/>
                <ruleml:Var type="lc:defendant">Defendant</ruleml:Var>
                <ruleml:Data xsi:type="xs:string">true</ruleml:Data>
              </ruleml:Atom>
          </ruleml:And>
