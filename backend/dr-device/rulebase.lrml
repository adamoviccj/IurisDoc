<?xml version="1.0" encoding="UTF-8"?>
<lrml:LegalRuleML
 xmlns:lrml="http://docs.oasis-open.org/legalruleml/ns/v1.0/"
 xmlns:xs="http://www.w3.org/2001/XMLSchema"
 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
 xmlns:ruleml="http://ruleml.org/spec">

  <lrml:Statements>

    <!-- ===================== RULES ===================== -->

    <lrml:PrescriptiveStatement key="ps220_1">
      <ruleml:Rule key=":rule220_1" closure="universal" strength="defeasible">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="lc:uses_gross_violence"/>
              <ruleml:Var type="lc:defendant">Defendant</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="lc:violates_integrity"/>
              <ruleml:Var type="lc:defendant">Defendant</ruleml:Var>
              <ruleml:Data xsi:type="xs:string">family_member</ruleml:Data>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom>
            <ruleml:Rel>is_guilty_of_family_violence_lv1</ruleml:Rel>
            <ruleml:Var type=":defendant">Defendant</ruleml:Var>
          </ruleml:Atom>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>

    <lrml:PrescriptiveStatement key="ps220_2">
      <ruleml:Rule key=":rule220_2" closure="universal" strength="defeasible">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel>is_guilty_of_family_violence_lv1</ruleml:Rel>
              <ruleml:Var type=":defendant">Defendant</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="lc:uses_weapon"/>
              <ruleml:Var type="lc:defendant">Defendant</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom>
            <ruleml:Rel>is_guilty_of_family_violence_lv2</ruleml:Rel>
            <ruleml:Var type=":defendant">Defendant</ruleml:Var>
          </ruleml:Atom>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>

    <!-- ===================== PENALTIES ===================== -->

    <!-- LV1 -->
    <lrml:PenaltyStatement key="pen220_1">
      <lrml:SuborderList>
        <lrml:Obligation>
          <ruleml:Atom>
            <ruleml:Rel iri=":max_imprisonment"/>
            <ruleml:Var>Years</ruleml:Var>
            <ruleml:Ind>2</ruleml:Ind>
          </ruleml:Atom>
        </lrml:Obligation>
      </lrml:SuborderList>
    </lrml:PenaltyStatement>

    <!-- LV2 MIN -->
    <lrml:PenaltyStatement key="pen220_2_min">
      <lrml:SuborderList>
        <lrml:Obligation>
          <ruleml:Atom>
            <ruleml:Rel iri=":min_imprisonment"/>
            <ruleml:Var>Months</ruleml:Var>
            <ruleml:Ind>3</ruleml:Ind>
          </ruleml:Atom>
        </lrml:Obligation>
      </lrml:SuborderList>
    </lrml:PenaltyStatement>

    <!-- LV2 MAX -->
    <lrml:PenaltyStatement key="pen220_2_max">
      <lrml:SuborderList>
        <lrml:Obligation>
          <ruleml:Atom>
            <ruleml:Rel iri=":max_imprisonment"/>
            <ruleml:Var>Years</ruleml:Var>
            <ruleml:Ind>3</ruleml:Ind>
          </ruleml:Atom>
        </lrml:Obligation>
      </lrml:SuborderList>
    </lrml:PenaltyStatement>

    <!-- ===================== REPARATIONS ===================== -->

    <lrml:ReparationStatement>
      <lrml:Reparation>
        <lrml:appliesPenalty keyref="#pen220_1"/>
        <lrml:toPrescriptiveStatement keyref="#ps220_1"/>
      </lrml:Reparation>
    </lrml:ReparationStatement>

    <lrml:ReparationStatement>
      <lrml:Reparation>
        <lrml:appliesPenalty keyref="#pen220_2_min"/>
        <lrml:toPrescriptiveStatement keyref="#ps220_2"/>
      </lrml:Reparation>
    </lrml:ReparationStatement>

    <lrml:ReparationStatement>
      <lrml:Reparation>
        <lrml:appliesPenalty keyref="#pen220_2_max"/>
        <lrml:toPrescriptiveStatement keyref="#ps220_2"/>
      </lrml:Reparation>
    </lrml:ReparationStatement>

    <!-- ===================== OVERRIDES ===================== -->

    <lrml:OverrideStatement>
      <lrml:Override under="#ps220_1" over="#ps220_2"/>
    </lrml:OverrideStatement>

  </lrml:Statements>
</lrml:LegalRuleML>