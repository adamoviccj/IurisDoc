    <lrml:PenaltyStatement key="pen220_1_prison">
      <lrml:SuborderList>
        <lrml:Obligation>
          <ruleml:Atom>
            <ruleml:Rel iri=":max_imprisonment"/>
            <ruleml:Var>Years</ruleml:Var>
            <ruleml:Ind>2</ruleml:Ind>
          </ruleml:Atom>
        </lrml:Obligation>
      </lrml:SuborderList>
    </lrml:PenaltyStatement>

    <lrml:PenaltyStatement key="pen220_1_fine">
    <lrml:SuborderList>
      <lrml:Obligation>
        <ruleml:Atom>
          <ruleml:Rel iri=":to_pay"/>
          <ruleml:Var>Money</ruleml:Var>
          <ruleml:Ind>1000</ruleml:Ind>
        </ruleml:Atom>
      </lrml:Obligation>
    </lrml:SuborderList>
    </lrml:PenaltyStatement>

    <lrml:PenaltyStatement key="pen220_2_min">
      <lrml:SuborderList>
        <lrml:Obligation>
          <ruleml:Atom>
            <ruleml:Rel iri=":min_imprisonment"/>
            <ruleml:Var>Months</ruleml:Var>
            <ruleml:Ind>3</ruleml:Ind>
