<?xml version="1.0" encoding="UTF-8"?>
<lrml:LegalRuleML
  xmlns:lrml="http://docs.oasis-open.org/legalruleml/ns/v1.0/"
  xmlns:xs="http://www.w3.org/2001/XMLSchema"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:ruleml="http://ruleml.org/spec">

  <lrml:Statements>

    <lrml:PrescriptiveStatement key="ps220_1">
      <ruleml:Rule key=":rule220_1" closure="universal" strength="defeasible">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="lc:uses_gross_violence"/>
              <ruleml:Var type="lc:defendant">Defendant</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="lc:violates_integrity"/>
              <ruleml:Var type="lc:defendant">Defendant</ruleml:Var>
              <ruleml:Data xsi:type="xs:string">family_member</ruleml:Data>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom>
            <ruleml:Rel>is_guilty_of_family_violence_lv1</ruleml:Rel>
            <ruleml:Var type=":defendant">Defendant</ruleml:Var>
          </ruleml:Atom>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>

    <lrml:PrescriptiveStatement key="ps220_2">
      <ruleml:Rule key=":rule220_2" closure="universal" strength="defeasible">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel>is_guilty_of_family_violence_lv1</ruleml:Rel>
              <ruleml:Var type=":defendant">Defendant</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="lc:uses_weapon"/>
              <ruleml:Var type="lc:defendant">Defendant</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom>
            <ruleml:Rel>is_guilty_of_family_violence_lv2</ruleml:Rel>
            <ruleml:Var type=":defendant">Defendant</ruleml:Var>
          </ruleml:Atom>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>

    <lrml:PrescriptiveStatement key="ps220_3">
      <ruleml:Rule key=":rule220_3" closure="universal" strength="defeasible">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel>is_guilty_of_family_violence_lv1</ruleml:Rel>
              <ruleml:Var type=":defendant">Defendant</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Or>
              <ruleml:Atom>
                <ruleml:Rel iri="lc:caused_severe_bodily_harm"/>
                <ruleml:Var type="lc:defendant">Defendant</ruleml:Var>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="lc:victim_is_minor"/>
                <ruleml:Var type="lc:defendant">Defendant</ruleml:Var>
              </ruleml:Atom>
            </ruleml:Or>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom>
            <ruleml:Rel>is_guilty_of_family_violence_lv3</ruleml:Rel>
            <ruleml:Var type=":defendant">Defendant</ruleml:Var>
          </ruleml:Atom>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>

    <lrml:PrescriptiveStatement key="ps220_4">
      <ruleml:Rule key=":rule220_4" closure="universal" strength="defeasible">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel>is_guilty_of_family_violence_lv1</ruleml:Rel>
              <ruleml:Var type=":defendant">Defendant</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="lc:caused_death"/>
              <ruleml:Var type="lc:defendant">Defendant</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom>
            <ruleml:Rel>is_guilty_of_family_violence_lv4</ruleml:Rel>
            <ruleml:Var type=":defendant">Defendant</ruleml:Var>
          </ruleml:Atom>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>

    <lrml:PrescriptiveStatement key="ps220_5">
      <ruleml:Rule key=":rule220_5" closure="universal" strength="defeasible">
        <ruleml:if>
          <ruleml:Atom>
            <ruleml:Rel iri="lc:violates_protection_measures"/>
            <ruleml:Var type="lc:defendant">Defendant</ruleml:Var>
          </ruleml:Atom>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom>
            <ruleml:Rel>is_guilty_of_violating_measures</ruleml:Rel>
            <ruleml:Var type=":defendant">Defendant</ruleml:Var>
          </ruleml:Atom>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>

    <lrml:PrescriptiveStatement key="ps221_1">
      <ruleml:Rule key=":rule221_1" closure="universal" strength="defeasible">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="lc:legal_obligation_to_support"/>
              <ruleml:Var type="lc:defendant">Defendant</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="lc:duty_established_by_court_order"/>
              <ruleml:Var type="lc:defendant">Defendant</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="lc:fails_to_pay_support"/>
              <ruleml:Var type="lc:defendant">Defendant</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Not>
              <ruleml:Atom>
                <ruleml:Rel iri="lc:justified_reasons_for_nonpayment"/>
                <ruleml:Var type="lc:defendant">Defendant</ruleml:Var>
              </ruleml:Atom>
            </ruleml:Not>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom>
            <ruleml:Rel>is_guilty_of_nonpayment_of_support_lv1</ruleml:Rel>
            <ruleml:Var type=":defendant">Defendant</ruleml:Var>
          </ruleml:Atom>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>

    <lrml:PrescriptiveStatement key="ps221_3">
      <ruleml:Rule key=":rule221_3" closure="universal" strength="defeasible">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel>is_guilty_of_nonpayment_of_support_lv1</ruleml:Rel>
              <ruleml:Var type=":defendant">Defendant</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="lc:severe_consequences_for_victim"/>
              <ruleml:Var type="lc:defendant">Defendant</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom>
            <ruleml:Rel>is_guilty_of_nonpayment_of_support_lv2</ruleml:Rel>
            <ruleml:Var type=":defendant">Defendant</ruleml:Var>
          </ruleml:Atom>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>

    <lrml:PenaltyStatement key="pen220_1">
      <lrml:SuborderList><lrml:Obligation><ruleml:Atom><ruleml:Rel iri=":max_imprisonment"/><ruleml:Var>Years</ruleml:Var><ruleml:Ind>2</ruleml:Ind></ruleml:Atom></lrml:Obligation></lrml:SuborderList>
    </lrml:PenaltyStatement>

    <lrml:PenaltyStatement key="pen220_2_min">
      <lrml:SuborderList><lrml:Obligation><ruleml:Atom><ruleml:Rel iri=":min_imprisonment"/><ruleml:Var>Months</ruleml:Var><ruleml:Ind>3</ruleml:Ind></ruleml:Atom></lrml:Obligation></lrml:SuborderList>
    </lrml:PenaltyStatement>
    <lrml:PenaltyStatement key="pen220_2_max">
      <lrml:SuborderList><lrml:Obligation><ruleml:Atom><ruleml:Rel iri=":max_imprisonment"/><ruleml:Var>Years</ruleml:Var><ruleml:Ind>3</ruleml:Ind></ruleml:Atom></lrml:Obligation></lrml:SuborderList>
    </lrml:PenaltyStatement>

    <lrml:PenaltyStatement key="pen220_3_min">
      <lrml:SuborderList><lrml:Obligation><ruleml:Atom><ruleml:Rel iri=":min_imprisonment"/><ruleml:Var>Years</ruleml:Var><ruleml:Ind>1</ruleml:Ind></ruleml:Atom></lrml:Obligation></lrml:SuborderList>
    </lrml:PenaltyStatement>
    <lrml:PenaltyStatement key="pen220_3_max">
      <lrml:SuborderList><lrml:Obligation><ruleml:Atom><ruleml:Rel iri=":max_imprisonment"/><ruleml:Var>Years</ruleml:Var><ruleml:Ind>5</ruleml:Ind></ruleml:Atom></lrml:Obligation></lrml:SuborderList>
    </lrml:PenaltyStatement>

    <lrml:PenaltyStatement key="pen220_4_min">
      <lrml:SuborderList><lrml:Obligation><ruleml:Atom><ruleml:Rel iri=":min_imprisonment"/><ruleml:Var>Years</ruleml:Var><ruleml:Ind>3</ruleml:Ind></ruleml:Atom></lrml:Obligation></lrml:SuborderList>
    </lrml:PenaltyStatement>
    <lrml:PenaltyStatement key="pen220_4_max">
      <lrml:SuborderList><lrml:Obligation><ruleml:Atom><ruleml:Rel iri=":max_imprisonment"/><ruleml:Var>Years</ruleml:Var><ruleml:Ind>12</ruleml:Ind></ruleml:Atom></lrml:Obligation></lrml:SuborderList>
    </lrml:PenaltyStatement>

    <lrml:PenaltyStatement key="pen220_5">
      <lrml:SuborderList><lrml:Obligation><ruleml:Atom><ruleml:Rel iri=":max_imprisonment"/><ruleml:Var>Years</ruleml:Var><ruleml:Ind>1</ruleml:Ind></ruleml:Atom></lrml:Obligation></lrml:SuborderList>
    </lrml:PenaltyStatement>

    <lrml:PenaltyStatement key="pen221_1">
      <lrml:SuborderList><lrml:Obligation><ruleml:Atom><ruleml:Rel iri=":max_imprisonment"/><ruleml:Var>Years</ruleml:Var><ruleml:Ind>2</ruleml:Ind></ruleml:Atom></lrml:Obligation></lrml:SuborderList>
    </lrml:PenaltyStatement>

    <lrml:PenaltyStatement key="pen221_3_min">
      <lrml:SuborderList><lrml:Obligation><ruleml:Atom><ruleml:Rel iri=":min_imprisonment"/><ruleml:Var>Months</ruleml:Var><ruleml:Ind>6</ruleml:Ind></ruleml:Atom></lrml:Obligation></lrml:SuborderList>
    </lrml:PenaltyStatement>
    <lrml:PenaltyStatement key="pen221_3_max">
      <lrml:SuborderList><lrml:Obligation><ruleml:Atom><ruleml:Rel iri=":max_imprisonment"/><ruleml:Var>Years</ruleml:Var><ruleml:Ind>5</ruleml:Ind></ruleml:Atom></lrml:Obligation></lrml:SuborderList>
    </lrml:PenaltyStatement>

    <lrml:ReparationStatement><lrml:Reparation><lrml:appliesPenalty keyref="#pen220_1"/><lrml:toPrescriptiveStatement keyref="#ps220_1"/></lrml:Reparation></lrml:ReparationStatement>
    <lrml:ReparationStatement><lrml:Reparation><lrml:appliesPenalty keyref="#pen220_2_min"/><lrml:toPrescriptiveStatement keyref="#ps220_2"/></lrml:Reparation></lrml:ReparationStatement>
    <lrml:ReparationStatement><lrml:Reparation><lrml:appliesPenalty keyref="#pen220_2_max"/><lrml:toPrescriptiveStatement keyref="#ps220_2"/></lrml:Reparation></lrml:ReparationStatement>
    <lrml:ReparationStatement><lrml:Reparation><lrml:appliesPenalty keyref="#pen220_3_min"/><lrml:toPrescriptiveStatement keyref="#ps220_3"/></lrml:Reparation></lrml:ReparationStatement>
    <lrml:ReparationStatement><lrml:Reparation><lrml:appliesPenalty keyref="#pen220_3_max"/><lrml:toPrescriptiveStatement keyref="#ps220_3"/></lrml:Reparation></lrml:ReparationStatement>
    <lrml:ReparationStatement><lrml:Reparation><lrml:appliesPenalty keyref="#pen220_4_min"/><lrml:toPrescriptiveStatement keyref="#ps220_4"/></lrml:Reparation></lrml:ReparationStatement>
    <lrml:ReparationStatement><lrml:Reparation><lrml:appliesPenalty keyref="#pen220_4_max"/><lrml:toPrescriptiveStatement keyref="#ps220_4"/></lrml:Reparation></lrml:ReparationStatement>
    <lrml:ReparationStatement><lrml:Reparation><lrml:appliesPenalty keyref="#pen220_5"/><lrml:toPrescriptiveStatement keyref="#ps220_5"/></lrml:Reparation></lrml:ReparationStatement>

    <lrml:ReparationStatement><lrml:Reparation><lrml:appliesPenalty keyref="#pen221_1"/><lrml:toPrescriptiveStatement keyref="#ps221_1"/></lrml:Reparation></lrml:ReparationStatement>
    <lrml:ReparationStatement><lrml:Reparation><lrml:appliesPenalty keyref="#pen221_3_min"/><lrml:toPrescriptiveStatement keyref="#ps221_3"/></lrml:Reparation></lrml:ReparationStatement>
    <lrml:ReparationStatement><lrml:Reparation><lrml:appliesPenalty keyref="#pen221_3_max"/><lrml:toPrescriptiveStatement keyref="#ps221_3"/></lrml:Reparation></lrml:ReparationStatement>

    <lrml:OverrideStatement><lrml:Override under="#ps220_1" over="#ps220_2"/></lrml:OverrideStatement>
    <lrml:OverrideStatement><lrml:Override under="#ps220_2" over="#ps220_3"/></lrml:OverrideStatement>
    <lrml:OverrideStatement><lrml:Override under="#ps220_3" over="#ps220_4"/></lrml:OverrideStatement>

    <lrml:OverrideStatement><lrml:Override under="#ps221_1" over="#ps221_3"/></lrml:OverrideStatement>

  </lrml:Statements>
</lrml:LegalRuleML>