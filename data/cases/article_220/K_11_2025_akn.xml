    <body eId="body">

      <header eId="header">
        <p eId="header.p1">U IME CRNE GORE</p>
      </header>

      <!-- SASTAV SUDA -->
      <introduction eId="sec.introduction">

        <panel eId="panel.composition">
          <judge eId="panel.j1"
                 refersTo="#person.branislavLekovic"
                 role="singleJudge"/>
          <clerk eId="panel.c1"
                 refersTo="#person.aleksandraMartinovic"/>
        </panel>

        <p eId="sec.introduction.p1">
          <ref href="#org.osnovniSudCetinje">Osnovni sud u Cetinju</ref>,
          sudija <ref href="#person.branislavLekovic">Branislav Leković</ref>,
          uz učešće zapisničarke
          <ref href="#person.aleksandraMartinovic">Aleksandre Martinović</ref>,
          u krivičnom predmetu protiv
          <party eId="party.accused"
                 refersTo="#person.LB"
                 role="accused">Lj. B.</party>,
          po optužnom predlogu ODT,
          u prisustvu zastupnice optužbe
          <party eId="party.prosecutor"
                 refersTo="#person.jelenaBlecić"
                 role="prosecutor"/>,
          dana 10.02.2025. godine donio je:
        </p>

      </introduction>

      <!-- IZREKA -->
      <decision eId="sec.decision">

        <article eId="sec.decision.guilt">
          <heading>Okrivljeni</heading>
          <p eId="sec.decision.guilt.p1">
            <ref href="#person.LB">Lj. B.</ref> oglašava se krivim
            zbog krivičnog djela
            nasilje u porodici ili u porodičnoj zajednici iz čl. 220 st. 4 u vezi st. 1
            <ref href="#law.KZCG">Krivičnog zakonika Crne Gore</ref>.
          </p>
        </article>

        <article eId="sec.decision.sanction">
          <heading>Krivična sankcija</heading>
          <p eId="sec.decision.sanction.p1">
            Okrivljeni se osuđuje na kaznu zatvora u trajanju od 1 (jedne) godine.
          </p>
          <p eId="sec.decision.sanction.p2">
            Na osnovu člana 72 <ref href="#law.KZCG">Krivičnog zakonika Crne Gore</ref> okrivljenom Lj. B. se izriče:
            MJERA BEZBIJEDNOSTI OBAVEZNO LIJEČENJE ALKOHOLIČARA
          </p>
        </article>

        <article eId="sec.decision.costs">
          <heading>Troškovi postupka</heading>
          <p eId="sec.decision.costs.p1">
            Okrivljeni je obavezan da plati na ime troškova krivičnog postupka iznos od 217,00 €, u roku od 15 dana
            po pravosnažnosti presude, pod prijetnjom izvršenja.
          </p>
        </article>

      </decision>

      <!-- OBRAZLOŽENJE -->
      <motivation eId="sec.motivation">

        <section eId="sec.motivation.facts">
          <heading>Utvrđeno činjenično stanje</heading>
          <p eId="sec.motivation.facts.p1">
            Sud je utvrdio da je okrivljeni dana ........ godine, oko 10,00 časova, u porodičnoj kući u u. B. P. br...., u C.,
            svjestan svog djela i zabranjenosti istog, upaljačem kao sredstvom podobnim da tijelo teško povrijedi ili
            zdravlje teško naruši, lako tjelesno povrijedio člana svoje porodice-svoju majku oštećenu
            <ref href="#person.LJN">Lj. N.</ref>.
          </p>
        </section>

        <section eId="sec.motivation.legal">
          <heading>Pravna kvalifikacija</heading>
          <p eId="sec.motivation.legal.p1">
            Radnjama okrivljenog ostvarena su sva obilježja krivičnog djela iz čl. 220 st. 4 u vezi st. 1
            <ref href="#law.KZCG">KZ CG</ref>.
          </p>
        </section>

        <section eId="sec.motivation.sanction">
          <heading>Odluka o kazni</heading>
          <p eId="sec.motivation.sanction.p1">
            Sud je cijenio olakšavajuće okolnosti kao što su loše imovno stanje okrivljenog, izraženo kajanje i
            činjenicu da se oštećena nije pridružila krivičnom gonjenju.
          </p>
        </section>

      </motivation>

