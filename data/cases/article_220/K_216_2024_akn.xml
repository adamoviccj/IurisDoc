    <body eId="body">

      <header eId="header">
        <p eId="header.p1">U IME CRNE GORE</p>
      </header>

      <!-- SASTAV SUDA -->
      <introduction eId="sec.introduction">

        <panel eId="panel.composition">
          <judge eId="panel.j1"
                 refersTo="#person.ivanDosljak"
                 role="singleJudge"/>
          <clerk eId="panel.c1"
                 refersTo="#person.momirkaFatic"/>
        </panel>

        <p eId="sec.introduction.p1">
          <ref href="#org.osnovniSudBerane">Osnovni sud u Beranama</ref>,
          sudija <ref href="#person.ivanDosljak">Došljak V. Ivan</ref>,
          uz učešće zapisničarke
          <ref href="#person.momirkaFatic">Fatić Momirke</ref>,
          u krivičnom predmetu protiv
          <party eId="party.accused"
                 refersTo="#person.HE"
                 role="accused">H. E.</party>,
          po optužnom predlogu ODT,
          u prisustvu zastupnice optužbe
          <party eId="party.prosecutor"
                 refersTo="#person.SA"
                 role="prosecutor"/>,
          dana 11.11.2024. godine donio je:
        </p>

      </introduction>

      <!-- IZREKA -->
      <decision eId="sec.decision">

        <article eId="sec.decision.guilt">
          <heading>Okrivljeni</heading>
          <p eId="sec.decision.guilt.p1">
            <ref href="#person.HE">H. E.</ref> oglašava se krivim
            zbog krivičnog djela
            nasilje u porodici ili u porodičnoj zajednici iz <ref href="#art_220__para_4">čl. 220 st. 4</ref> u vezi <ref href="#art_220__para_1">st. 1</ref>
            <ref href="#law.KZCG">Krivičnog zakonika Crne Gore</ref>.
          </p>
        </article>

        <article eId="sec.decision.sanction">
          <heading>Krivična sankcija</heading>
          <p eId="sec.decision.sanction.p1">
            Izriče se kazna zatvora u trajanju od 1 godine,
            u koju kaznu mu se uračunava vrijeme provedeno u pritvoru
            od 12.09.2024. godine, od 16,20 časova, pa na dalje.
          </p>
        </article>

        <article eId="sec.decision.costs">
          <heading>Troškovi postupka</heading>
          <p eId="sec.decision.costs.p1">
            Okrivljeni je dužan da plati troškove postupka
            u iznosu od 600,00 eura i sudski paušal
            u iznosu od 30,00 eura,
            shodno <ref href="#law.ZKP">ZKP</ref>.
          </p>
        </article>

      </decision>

      <!-- OBRAZLOŽENJE -->
      <motivation eId="sec.motivation">

        <section eId="sec.motivation.facts">
          <heading>Utvrđeno činjenično stanje</heading>
          <p eId="sec.motivation.facts.p1">
            Sud je utvrdio da okrivljeni dana 11.09.2024. godine,
            oko 16,00 časova, u porodičnoj kući u R....a,
            svjestan svog djela čije je izvršenje htio,
            ugrozio sigurnost svoje bračne supruge
            <ref href="#person.AH">A. H.</ref>,
            prijetnjom da će napasti na njen život i tijelo,
            u prisustvu njihove djece E... i S.... H.,
            na način što joj je uputio prijeteće riječi „ubiću te kad zaspiš“.
          </p>
        </section>

        <section eId="sec.motivation.legal">
          <heading>Pravna kvalifikacija</heading>
          <p eId="sec.motivation.legal.p1">
            Radnjama okrivljenog ostvarena su sva obilježja
            krivičnog djela iz <ref href="#art_220__para_4">čl. 220 st. 4</ref> u vezi <ref href="#art_220__para_1">st. 1</ref>
            <ref href="#law.KZCG">KZ CG</ref>.
          </p>
        </section>

        <section eId="sec.motivation.sanction">
          <heading>Odluka o kazni</heading>
          <p eId="sec.motivation.sanction.p1">
            Kao olakšavajuće okolnosti sud je cijenio
            da je okrivljeni otac dvoje djece i siromašnog imovnog stanja,
            dok je kao otežavajuću okolnost cijenio njegovu raniju osuđivanost.
          </p>
        </section>

      </motivation>

