    <body eId="body">

      <header eId="header">
        <p eId="header.p1">U IME CRNE GORE</p>
      </header>

      <!-- SASTAV SUDA -->
      <introduction eId="sec.introduction">

        <panel eId="panel.composition">
          <judge eId="panel.j1"
                 refersTo="#person.bojanaRadovic"
                 role="singleJudge"/>
          <clerk eId="panel.c1"
                 refersTo="#person.koviljkaLjesnjak"/>
        </panel>

        <p eId="sec.introduction.p1">
          <ref href="#org.osnovniSudBijeloPolje">Osnovni sud u Bijelom Polju</ref>,
          sudija <ref href="#person.bojanaRadovic">Bojana Radović</ref>,
          uz učešće zapisničarke
          <ref href="#person.koviljkaLjesnjak">Koviljke Lješnjak</ref>,
          u krivičnom predmetu protiv
          <party eId="party.accused"
                 refersTo="#person.BP"
                 role="accused">B. P.</party>,
          po optužnom predlogu ODT,
          u prisustvu savjetnika optužbe
          <party eId="party.prosecutor"
                 refersTo="#person.ljubisaJokic"
                 role="prosecutor"/>,
          dana 22.07.2024. godine donio je:
        </p>

      </introduction>

      <!-- IZREKA -->
      <decision eId="sec.decision">

        <article eId="sec.decision.guilt">
          <heading>Okrivljeni</heading>
          <p eId="sec.decision.guilt.p1">
            <ref href="#person.BP">B. P.</ref> oglašava se krivim
            zbog krivičnog djela
            nasilje u porodici ili u porodičnoj zajednici iz čl. 220 st. 1
            <ref href="#law.KZCG">Krivičnog zakonika Crne Gore</ref>.
          </p>
        </article>

        <article eId="sec.decision.sanction">
          <heading>Krivična sankcija</heading>
          <p eId="sec.decision.sanction.p1">
            Izriče se kazna zatvora u trajanju od 30 dana,
            koja će se izvršiti izdržavanjem u prostorijama u kojima okrivljeni stanuje,
            uz primjenu elektronskog nadzora.
          </p>
        </article>

        <article eId="sec.decision.costs">
          <heading>Troškovi postupka</heading>
          <p eId="sec.decision.costs.p1">
            Okrivljeni se obavezuje da plati troškove postupka
            u iznosu od 30,00 € na ime paušala i 126,50 € na ime ostalih troškova,
            koje će uplatiti na račun Budžeta CG broj 832-151-35,
            u roku od 15 dana po pravosnažnosti presude.
          </p>
        </article>

        <article eId="sec.decision.acquittal">
          <heading>Oslobađanje od optužbe</heading>
          <p eId="sec.decision.acquittal.p1">
            Na osnovu čl. 373 st. 1 tač. 2
            <ref href="#law.ZKP">Zakonika o krivičnom postupku</ref>,
            okrivljeni <ref href="#person.BP">B. P.</ref> se oslobađa od optužbe
            za dva krivična djela nasilje u porodici ili u porodičnoj zajednici iz čl. 220 st. 3
            u vezi stava 1 Krivičnog zakonika u sticaju sa krivičnim djelom
            ugrožavanje sigurnosti iz čl. 168 st. 1 Krivičnog zakonika.
          </p>
        </article>

      </decision>

      <!-- OBRAZLOŽENJE -->
      <motivation eId="sec.motivation">

        <section eId="sec.motivation.facts">
          <heading>Utvrđeno činjenično stanje</heading>
          <p eId="sec.motivation.facts.p1">
            Sud je utvrdio da okrivljeni dana 01.04.2023. godine,
            oko 21,45 h, u mjestu P., opština M.,
            ispred pomoćnog objekta u blizini njegove porodične kuće,
            primjenom grubog nasilja, narušio duševni integritet člana svoje porodice,
            oštećenog sinovca <ref href="#person.MM">M. M.</ref>,
            na način što mu je, nakon kraće rasprave i prepirke,
            uputio riječi prijetnje ''zapaliću objekat i ubiću te, jebaću ti majku".
          </p>
        </section>

        <section eId="sec.motivation.legal">
          <heading>Pravna kvalifikacija</heading>
          <p eId="sec.motivation.legal.p1">
            Radnjama okrivljenog ostvarena su sva obilježja
            krivičnog djela iz čl. 220 st. 1
            <ref href="#law.KZCG">KZ CG</ref>.
          </p>
        </section>

        <section eId="sec.motivation.sanction">
          <heading>Odluka o kazni</heading>
          <p eId="sec.motivation.sanction.p1">
            Sud je cijenio raniju osuđivanost okrivljenog i imovinske prilike,
            te je izrekao kaznu zatvora od 30 dana uz elektronski nadzor.
          </p>
        </section>

      </motivation>

