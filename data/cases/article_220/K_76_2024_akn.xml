    <body eId="body">

      <header eId="header">
        <p eId="header.p1">U IME CRNE GORE</p>
      </header>

      <!-- SASTAV SUDA -->
      <introduction eId="sec.introduction">

        <panel eId="panel.composition">
          <judge eId="panel.j1"
                 refersTo="#person.larisaMijuskovicStamatovic"
                 role="singleJudge"/>
          <clerk eId="panel.c1"
                 refersTo="#person.marinaSekulic"/>
        </panel>

        <p eId="sec.introduction.p1">
          <ref href="#org.osnovniSudPodgorica">Osnovni sud u Podgorici</ref>,
          sudija <ref href="#person.larisaMijuskovicStamatovic">Larisa Mijušković-Stamatović</ref>,
          uz učešće zapisničarke
          <ref href="#person.marinaSekulic">Marine Sekulić</ref>,
          u krivičnom predmetu protiv
          <party eId="party.accused"
                 refersTo="#person.MD"
                 role="accused">M. D.</party>,
          po optužnom predlogu ODT,
          u prisustvu zastupnice optužbe
          <party eId="party.prosecutor"
                 refersTo="#person.julijaDrincic"
                 role="prosecutor"/>,
          dana 20.03.2024. godine donio je:
        </p>

      </introduction>

      <!-- IZREKA -->
      <decision eId="sec.decision">

        <article eId="sec.decision.guilt">
          <heading>Okrivljeni</heading>
          <p eId="sec.decision.guilt.p1">
            <ref href="#person.MD">M. D.</ref> oglašava se krivim
            zbog krivičnog djela
            nasilje u porodici ili u porodičnoj zajednici iz čl. 220 st. 1
            <ref href="#law.KZCG">Krivičnog zakonika Crne Gore</ref>.
          </p>
        </article>

        <article eId="sec.decision.sanction">
          <heading>Krivična sankcija</heading>
          <p eId="sec.decision.sanction.p1">
            Izriče se kazna zatvora u trajanju od 8 mjeseci,
            u koju kaznu mu se uračunava vrijeme provedeno u pritvoru
            od 14.02.2024. godine od 18,35 časova, pa nadalje.
          </p>
        </article>

        <article eId="sec.decision.costs">
          <heading>Troškovi postupka</heading>
          <p eId="sec.decision.costs.p1">
            Okrivljeni je dužan da plati troškove postupka
            u iznosu od 60,50 eura i sudski paušal
            u iznosu od 40,00 eura,
            shodno čl. 229
            <ref href="#law.ZKP">ZKP</ref>.
          </p>
        </article>

        <article eId="sec.decision.securityMeasure">
          <heading>Mjera bezbjednosti</heading>
          <p eId="sec.decision.securityMeasure.p1">
            Sud okrivljenom, na osnovu čl. 67 st. 1 tač. 11 i čl. 77b
            <ref href="#law.KZCG">Krivičnog zakonika Crne Gore</ref>,
            izriče mjeru bezbjednosti udaljenje iz stana ili drugog prostora za stanovanje,
            u kojem živi oštećena <ref href="#person.MS">M. S.</ref>,
            koja mjera će trajati 3 mjeseca, po pravosnažnosti presude.
          </p>
        </article>

      </decision>

      <!-- OBRAZLOŽENJE -->
      <motivation eId="sec.motivation">

        <section eId="sec.motivation.facts">
          <heading>Utvrđeno činjenično stanje</heading>
          <p eId="sec.motivation.facts.p1">
            Sud je utvrdio da okrivljeni dana 14. februara 2024. godine,
            oko 08,00 časova, u porodičnoj kući na adresi u Ulici p. br...., u P.,
            svjestan svog djela, čije je izvršenje htio i znajući da je isto zabranjeno,
            lako tjelesno povrijedio člana porodične zajednice - oštećenu snahu
            <ref href="#person.MS">M. S.</ref> i istoj ugrozio sigurnost prijetnjom
            da će napasti na njen život i život njoj bliskog lica - supruga M.
          </p>
        </section>

        <section eId="sec.motivation.legal">
          <heading>Pravna kvalifikacija</heading>
          <p eId="sec.motivation.legal.p1">
            Radnjama okrivljenog ostvarena su sva obilježja
            krivičnog djela iz čl. 220 st. 1
            <ref href="#law.KZCG">KZ CG</ref>.
          </p>
        </section>

        <section eId="sec.motivation.sanction">
          <heading>Odluka o kazni</heading>
          <p eId="sec.motivation.sanction.p1">
            Sud je prilikom odlučivanja o visini kazne za okrivljenog M. D.
            imao u vidu sve okolnosti koje utiču da kazna bude veća ili manja,
            odnosno olakšavajuće i otežavajuće okolnosti.
          </p>
        </section>

      </motivation>

