    <body eId="body">

      <header eId="header">
        <p eId="header.p1">U IME CRNE GORE</p>
      </header>

      <!-- SASTAV SUDA -->
      <introduction eId="sec.introduction">

        <panel eId="panel.composition">
          <judge eId="panel.j1"
                 refersTo="#person.anaKenjićĐukić"
                 role="singleJudge"/>
          <clerk eId="panel.c1"
                 refersTo="#person.magdalenaVukotić"/>
        </panel>

        <p eId="sec.introduction.p1">
          <ref href="#org.osnovniSudBerane">Osnovni sud u Beranama</ref>,
          sudija <ref href="#person.anaKenjićĐukić">Ana Kenjić Đukić</ref>,
          uz učešće zapisničarke
          <ref href="#person.magdalenaVukotić">Magdalene Vukotić</ref>,
          u krivičnom predmetu protiv
          <party eId="party.accused"
                 refersTo="#person.NV"
                 role="accused">N. V.</party>,
          po optužnom predlogu ODT,
          u prisustvu zastupnika optužbe
          <party eId="party.prosecutor"
                 refersTo="#person.MB"
                 role="prosecutor"/>,
          dana 24.06.2024. godine donio je:
        </p>

      </introduction>

      <!-- IZREKA -->
      <decision eId="sec.decision">

        <article eId="sec.decision.guilt">
          <heading>Okrivljeni</heading>
          <p eId="sec.decision.guilt.p1">
            <ref href="#person.NV">N. V.</ref> oglašava se krivim
            zbog krivičnog djela
            nasilje u porodici ili u porodičnoj zajednici iz čl. 220 st. 1 i 2
            <ref href="#law.KZCG">Krivičnog zakonika Crne Gore</ref>.
          </p>
        </article>

        <article eId="sec.decision.sanction">
          <heading>Krivična sankcija</heading>
          <p eId="sec.decision.sanction.p1">
            Izriče se kazna zatvora u trajanju od 6 mjeseci,
            u koju kaznu se uračunava vrijeme provedeno u pritvoru
            od 10.04.2024. godine do 24.05.2024. godine.
          </p>
        </article>

        <article eId="sec.decision.costs">
          <heading>Troškovi postupka</heading>
          <p eId="sec.decision.costs.p1">
            Okrivljeni je dužan da plati troškove postupka
            u iznosu od 707,50 eura i paušal u iznosu od 40,00 eura,
            shodno čl. 226 i 229
            <ref href="#law.ZKP">ZKP</ref>.
          </p>
        </article>

      </decision>

      <!-- OBRAZLOŽENJE -->
      <motivation eId="sec.motivation">

        <section eId="sec.motivation.facts">
          <heading>Utvrđeno činjenično stanje</heading>
          <p eId="sec.motivation.facts.p1">
            Sud je utvrdio da okrivljeni dana 10.04.2024. godine,
            u alkoholisanom stanju i pod dejstvom psihoaktivne supstance,
            ugrozio sigurnost člana svoje porodice – svog brata
            <ref href="#person.PV">P. V.</ref>,
            postupajući na način koji vrijeđa ljudsko dostojanstvo.
          </p>
        </section>

        <section eId="sec.motivation.legal">
          <heading>Pravna kvalifikacija</heading>
          <p eId="sec.motivation.legal.p1">
            Radnjama okrivljenog ostvarena su sva obilježja
            krivičnog djela iz čl. 220 st. 1 i 2
            <ref href="#law.KZCG">KZ CG</ref>.
          </p>
        </section>

        <section eId="sec.motivation.sanction">
          <heading>Odluka o kazni</heading>
          <p eId="sec.motivation.sanction.p1">
            Sud je cijenio olakšavajuće okolnosti kao što su
            izraženo kajanje okrivljenog i izvinjenje oštećenom.
          </p>
        </section>

      </motivation>

