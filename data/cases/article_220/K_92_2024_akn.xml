    <body eId="body">

      <header eId="header">
        <p eId="header.p1">U IME CRNE GORE</p>
      </header>

      <!-- SASTAV SUDA -->
      <introduction eId="sec.introduction">

        <panel eId="panel.composition">
          <judge eId="panel.j1"
                 refersTo="#person.ivanDosljak"
                 role="singleJudge"/>
          <clerk eId="panel.c1"
                 refersTo="#person.anitaMihajlovic"/>
        </panel>

        <p eId="sec.introduction.p1">
          <ref href="#org.osnovniSudBerane">Osnovni sud u Beranama</ref>,
          sudija <ref href="#person.ivanDosljak">Došljak V. Ivan</ref>,
          uz učešće zapisničarke
          <ref href="#person.anitaMihajlovic">Mihajlović Anite</ref>,
          u krivičnom predmetu protiv
          <party eId="party.accused"
                 refersTo="#person.KA"
                 role="accused">K. A.</party>,
          po optužnom predlogu ODT,
          u prisustvu zastupnice optužbe
          <party eId="party.prosecutor"
                 refersTo="#person.SA"
                 role="prosecutor"/>,
          dana 16.05.2024. godine donio je:
        </p>

      </introduction>

      <!-- IZREKA -->
      <decision eId="sec.decision">

        <article eId="sec.decision.guilt">
          <heading>Okrivljeni</heading>
          <p eId="sec.decision.guilt.p1">
            <ref href="#person.KA">K. A.</ref> oglašava se krivim
            zbog krivičnih djela
            nasilje u porodici ili u porodičnoj zajednici iz <ref href="#art_220__para_1">čl. 220 st. 1</ref> i
            nasilje u porodici ili u porodičnoj zajednici iz <ref href="#art_220__para_5">čl. 220 st. 7</ref>
            <ref href="#law.KZCG">Krivičnog zakonika Crne Gore</ref>.
          </p>
        </article>

        <article eId="sec.decision.sanction">
          <heading>Krivična sankcija</heading>
          <p eId="sec.decision.sanction.p1">
            Sud utvrđuje kaznu zatvora u trajanju od 6 mjeseci za
            krivično djelo iz <ref href="#art_220__para_1">čl. 220 st. 1</ref> i
            kaznu zatvora u trajanju od 30 dana za krivično djelo iz
            <ref href="#art_220__para_5">čl. 220 st. 7</ref>.
          </p>
          <p eId="sec.decision.sanction.p2">
            Okrivljeni se osuđuje na jedinstvenu kaznu zatvora u trajanju od 6 mjeseci.
          </p>
        </article>

        <article eId="sec.decision.costs">
          <heading>Troškovi postupka</heading>
          <p eId="sec.decision.costs.p1">
            Okrivljeni je dužan da plati troškove postupka
            u iznosu od 484,00 eura i sudski paušal
            u iznosu od 30,00 eura,
            shodno čl. 226 i 229
            <ref href="#law.ZKP">ZKP</ref>.
          </p>
        </article>

      </decision>

      <!-- OBRAZLOŽENJE -->
      <motivation eId="sec.motivation">

        <section eId="sec.motivation.facts">
          <heading>Utvrđeno činjenično stanje</heading>
          <p eId="sec.motivation.facts.p1">
            Sud je utvrdio da je okrivljeni dana 18.03.2024. godine,
            ispred svoje porodične kuće u R...., ugrozio sigurnost člana svoje porodice
            – brata <ref href="#person.KS">K. S.</ref> prijetnjom da će napasti na njegov život i tijelo,
            na način što ga je dohvatio rukom za odjeću u predjelu grudi,
            dok je u drugoj ruci držao sjekiru, kojom prilikom mu je uputio prijeteće riječi
            „groba mi majčinog, ubiću te, ili ti ili ja jedan neće biti živ“.
          </p>
          <p eId="sec.motivation.facts.p2">
            Takođe, prekršio je mjere zaštite od nasilja u porodici koje mu je
            S... za prekršaje B... P... – Odjeljenje R.... odredio na osnovu zakona,
            rješenjem PP.br...../24 od 17.03.2024. godine, i to zaštitnu mjeru zabrane
            uznemiravanja i uhođenja žrtve nasilja – sinovca <ref href="#person.KD">K. D.</ref>,
            na način što mu je uputio riječi „jebem ti sve, nemoj da se miješaš u naše probleme“.
          </p>
        </section>

        <section eId="sec.motivation.legal">
          <heading>Pravna kvalifikacija</heading>
          <p eId="sec.motivation.legal.p1">
            Radnjama okrivljenog ostvarena su sva obilježja
            krivičnih djela iz <ref href="#art_220__para_1">čl. 220 st. 1</ref> i
            <ref href="#art_220__para_5">čl. 220 st. 7</ref>
            <ref href="#law.KZCG">KZ CG</ref>.
          </p>
        </section>

        <section eId="sec.motivation.sanction">
          <heading>Odluka o kazni</heading>
          <p eId="sec.motivation.sanction.p1">
            Kao olakšavajuće okolnosti sud je cijenio
            da je okrivljeni otac jednog djeteta i da je siromašnog imovnog stanja,
            dok je kao otežavajuću okolnost cijenio njegovu raniju osuđivanost.
          </p>
        </section>

      </motivation>

