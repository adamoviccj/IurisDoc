    <body eId="body">

      <header eId="header">
        <p eId="header.p1">U IME CRNE GORE</p>
      </header>

      <!-- SASTAV SUDA -->
      <introduction eId="sec.introduction">

        <panel eId="panel.composition">
          <judge eId="panel.j1"
                 refersTo="#person.branislavLekovic"
                 role="singleJudge"/>
          <clerk eId="panel.c1"
                 refersTo="#person.aleksandraMartinovic"/>
        </panel>

        <p eId="sec.introduction.p1">
          <ref href="#org.osnovniSudCetinje">Osnovni sud u Cetinju</ref>,
          sudija <ref href="#person.branislavLekovic">Branislav Leković</ref>,
          uz učešće zapisničarke
          <ref href="#person.aleksandraMartinovic">Aleksandre Martinović</ref>,
          u krivičnom predmetu protiv
          <party eId="party.accused"
                 refersTo="#person.KB"
                 role="accused">K. B.</party>,
          po optužnom predlogu ODT,
          u prisustvu zastupnice optužbe
          <party eId="party.prosecutor"
                 refersTo="#person.andjaRadovanovic"
                 role="prosecutor"/>,
          dana 13.05.2024. godine donio je:
        </p>

      </introduction>

      <!-- IZREKA -->
      <decision eId="sec.decision">

        <article eId="sec.decision.guilt">
          <heading>Okrivljeni</heading>
          <p eId="sec.decision.guilt.p1">
            <ref href="#person.KB">K. B.</ref> oglašava se krivim
            zbog krivičnog djela
            nedavanje izdržavanja iz <ref href="#art_221__para_1">čl. 221 st. 1</ref>
            <ref href="#law.KZCG">Krivičnog zakonika Crne Gore</ref>.
          </p>
        </article>

        <article eId="sec.decision.sanction">
          <heading>Krivična sankcija</heading>
          <p eId="sec.decision.sanction.p1">
            Izriče se kazna zatvora u trajanju od 3 mjeseca,
            koju će okrivljeni izdržati u prostorijama u kojima stanuje.
          </p>
        </article>

        <article eId="sec.decision.compensation">
          <heading>Obaveza izdržavanja</heading>
          <p eId="sec.decision.compensation.p1">
            Okrivljeni je dužan da oštećenoj
            <party eId="party.victim"
                   refersTo="#person.KJ"
                   role="victim">K. J.</party>
            uredno daje izdržavanje.
          </p>
        </article>

        <article eId="sec.decision.costs">
          <heading>Troškovi postupka</heading>
          <p eId="sec.decision.costs.p1">
            Okrivljeni je dužan da plati troškove krivičnog postupka
            u iznosu od 30,00 eura na ime sudskog paušala,
            u roku od 15 dana po pravosnažnosti presude,
            pod prijetnjom prinudnog izvršenja.
          </p>
        </article>

      </decision>

      <!-- OBRAZLOŽENJE -->
      <motivation eId="sec.motivation">

        <section eId="sec.motivation.facts">
          <heading>Utvrđeno činjenično stanje</heading>
          <p eId="sec.motivation.facts.p1">
            Sud je utvrdio da okrivljeni u periodu
            od ... godine do ... godine,
            za mjesece oktobar, novembar i decembar ... godine,
            svjestan svog djela čije izvršenje je htio,
            znajući da je isto zabranjeno,
            nije davao izdržavanje za lice koje je po zakonu dužan da izdržava,
            za svoju kćerku-oštećenu <ref href="#person.KJ">K. J.</ref>,
            koja je upisana studijske ... godine kao student
            koji se finansira iz Budžeta Crne Gore na akademske Master studije,
            koje realizuje P. f. P., U. C. G.,
            a koja dužnost mu je utvrđena pravosnažnom i izvršnom presudom
            Osnovnog suda u Cetinju P.br.... od 09.12.2014. godine,
            u iznosu i na način kako je to istom presudom utvrđeno,
            svakomjesečnom uplatom iznosa od 120,00 eura
            od prvog do petog u mjesecu za tekući mjesec,
            na žiro račun oštećene, dok za to budu postojali zakonski uslovi,
            čime je izvršio krivično djelo nedavanje izdržavanja
            iz <ref href="#art_221__para_1">čl. 221 st. 1</ref>
            <ref href="#law.KZCG">Krivičnog zakonika Crne Gore</ref>.
          </p>
        </section>

        <section eId="sec.motivation.legal">
          <heading>Pravna kvalifikacija</heading>
          <p eId="sec.motivation.legal.p1">
            Radnjama okrivljenog ostvarena su sva obilježja
            krivičnog djela iz <ref href="#art_221__para_1">čl. 221 st. 1</ref>
            <ref href="#law.KZCG">KZ CG</ref>.
          </p>
        </section>

        <section eId="sec.motivation.sanction">
          <heading>Odluka o kazni</heading>
          <p eId="sec.motivation.sanction.p1">
            Sud je cijenio i navode odbrane okrivljenog da nije znao
            da njegova kćerka oštećena <ref href="#person.KJ">K. J.</ref> i dalje studira,
            međutim po ocjeni suda odbrana okrivljenog u tom dijelu je neuvjerljiva,
            opovrgnuta provedenim dokazima.
          </p>
        </section>

      </motivation>

