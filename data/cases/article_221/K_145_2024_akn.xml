    <body eId="body">

      <header eId="header">
        <p eId="header.p1">U IME CRNE GORE</p>
      </header>

      <!-- SASTAV SUDA -->
      <introduction eId="sec.introduction">

        <panel eId="panel.composition">
          <judge eId="panel.j1"
                 refersTo="#person.vesnaGazdic"
                 role="singleJudge"/>
          <clerk eId="panel.c1"
                 refersTo="#person.katarinaRistic"/>
        </panel>

        <p eId="sec.introduction.p1">
          <ref href="#org.osnovniSudHercegNovi">Osnovni sud u Herceg Novom</ref>,
          sudija <ref href="#person.vesnaGazdic">Vesna Gazdić</ref>,
          uz učešće zapisničarke
          <ref href="#person.katarinaRistic">Katarine Ristić</ref>,
          po optužnom predlogu ODT,
          u prisustvu zastupnika optužbe
          <party eId="party.prosecutor"
                 refersTo="#person.ristoStijovic"
                 role="prosecutor"/>,
          dana 12.02.2025. godine donio je:
        </p>

      </introduction>

      <!-- IZREKA -->
      <decision eId="sec.decision">

        <article eId="sec.decision.guilt">
          <heading>Okrivljeni</heading>
          <p eId="sec.decision.guilt.p1">
            <ref href="#person.JV">J. V.</ref> oglašava se krivim
            zbog dva krivična djela
            nedavanje izdržavanja iz čl. 221 st. 1
            <ref href="#law.KZCG">Krivičnog zakonika Crne Gore</ref>.
          </p>
        </article>

        <article eId="sec.decision.sanction">
          <heading>Krivična sankcija</heading>
          <p eId="sec.decision.sanction.p1">
            Izriče se uslovna osuda kojom se utvrđuje jedinstvena kazna zatvora
            u trajanju od 3 (tri) mjeseca,
            sa rokom provjeravanja od 1 godine.
          </p>
        </article>

        <article eId="sec.decision.compensation">
          <heading>Imovinskopravna obaveza</heading>
          <p eId="sec.decision.compensation.p1">
            Okrivljeni je dužan da zakonskoj zastupnici
            <ref href="#person.JD">J. D.</ref>,
            isplati dugovani iznos od 1.750,00 eura.
          </p>
        </article>

        <article eId="sec.decision.costs">
          <heading>Troškovi postupka</heading>
          <p eId="sec.decision.costs.p1">
            Okrivljeni se obavezuje da naknadi troškove krivičnog postupka
            u iznosu od 55,00 eura i troškove paušala
            u ukupnom iznosu od 30,00 eura,
            shodno čl. 226, 229, 239 i 374
            <ref href="#law.ZKP">ZKP</ref>.
          </p>
        </article>

      </decision>

      <!-- OBRAZLOŽENJE -->
      <motivation eId="sec.motivation">

        <section eId="sec.motivation.facts">
          <heading>Utvrđeno činjenično stanje</heading>
          <p eId="sec.motivation.facts.p1">
            Okrivljeni u periodu od 01.01.2023. do 29.07.2024.
            nije davao izdržavanje za svoju maloljetnu djecu
            <ref href="#person.JL">J. L.</ref> i <ref href="#person.JX">J. X.</ref>,
            iako je ta obaveza utvrđena pravosnažnom presudom.
          </p>
        </section>

        <section eId="sec.motivation.legal">
          <heading>Pravna kvalifikacija</heading>
          <p eId="sec.motivation.legal.p1">
            Radnjama okrivljenog ostvarena su sva obilježja
            krivičnog djela iz čl. 221 st.1
            <ref href="#law.KZCG">KZ CG</ref>.
          </p>
        </section>

      </motivation>

