    <body eId="body">

      <header eId="header">
        <p eId="header.p1">U IME CRNE GORE</p>
      </header>

      <!-- SASTAV SUDA -->
      <introduction eId="sec.introduction">

        <panel eId="panel.composition">
          <judge eId="panel.j1"
                 refersTo="#person.borkoLoncar"
                 role="singleJudge"/>
          <clerk eId="panel.c1"
                 refersTo="#person.ljiljanaIvanovic"/>
        </panel>

        <p eId="sec.introduction.p1">
          <ref href="#org.osnovniSudPodgorica">Osnovni sud u Podgorici</ref>,
          sudija <ref href="#person.borkoLoncar">Borko Lončar</ref>,
          uz učešće zapisničarke
          <ref href="#person.ljiljanaIvanovic">Ljiljane Ivanović</ref>,
          u krivičnom predmetu protiv
          <party eId="party.accused"
                 refersTo="#person.SB"
                 role="accused">Š. B.</party>,
          po optužnom predlogu ODT,
          u prisustvu zastupnice optužbe
          <party eId="party.prosecutor"
                 refersTo="#person.nadezdaKovacevicSofranac"
                 role="prosecutor"/>,
          dana 15.04.2024. godine donio je:
        </p>

      </introduction>

      <!-- IZREKA -->
      <decision eId="sec.decision">

        <article eId="sec.decision.guilt">
          <heading>Okrivljeni</heading>
          <p eId="sec.decision.guilt.p1">
            <ref href="#person.SB">Š. B.</ref> oglašava se krivim
            zbog tri krivična djela
            nedavanje izdržavanja iz <ref href="#art_221__para_1">čl. 221 st. 1</ref>
            <ref href="#law.KZCG">Krivičnog zakonika Crne Gore</ref>.
          </p>
        </article>

        <article eId="sec.decision.sanction">
          <heading>Krivična sankcija</heading>
          <p eId="sec.decision.sanction.p1">
            Izriče se uslovna osuda kojom se utvrđuje jedinstvena kazna zatvora
            u trajanju od 5 (pet) mjeseci,
            sa rokom provjeravanja od 2 (dvije) godine.
          </p>
        </article>

        <article eId="sec.decision.compensation">
          <heading>Imovinskopravna obaveza</heading>
          <p eId="sec.decision.compensation.p1">
            Okrivljeni je dužan da plati na ime troškova krivičnog postupka
            – sudskog paušala, u korist Budžeta Crne Gore iznos od 30,00 eura,
            u roku od 15 dana po pravosnažnosti presude, pod prijetnjom prinudnog izvršenja.
          </p>
        </article>

      </decision>

      <!-- OBRAZLOŽENJE -->
      <motivation eId="sec.motivation">

        <section eId="sec.motivation.facts">
          <heading>Utvrđeno činjenično stanje</heading>
          <p eId="sec.motivation.facts.p1">
            Sud je utvrdio da okrivljeni u januaru i februaru mjesecu 2024. godine,
            do petog u mjesecu, u Podgorici, nije davao izdržavanje za svoju maloljetnu djecu
            <ref href="#person.SG">Š. G.</ref>, <ref href="#person.SD1">Š. D.</ref> i <ref href="#person.SD2">Š. D.</ref>,
            iako je ta obaveza utvrđena pravosnažnom presudom.
          </p>
        </section>

        <section eId="sec.motivation.legal">
          <heading>Pravna kvalifikacija</heading>
          <p eId="sec.motivation.legal.p1">
            Radnjama okrivljenog ostvarena su sva obilježja
            krivičnog djela iz <ref href="#art_221__para_1">čl. 221 st. 1</ref>
            <ref href="#law.KZCG">KZ CG</ref>.
          </p>
        </section>

        <section eId="sec.motivation.sanction">
          <heading>Odluka o kazni</heading>
          <p eId="sec.motivation.sanction.p1">
            Kao olakšavajuće okolnosti sud je cijenio
            prihvatanje odgovornosti za predmetno krivično djelo,
            loše imovno stanje i naknadno izmirenje obaveza.
          </p>
        </section>

      </motivation>

