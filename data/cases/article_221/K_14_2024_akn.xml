    <body eId="body">

      <header eId="header">
        <p eId="header.p1">U IME CRNE GORE</p>
      </header>

      <!-- SASTAV SUDA -->
      <introduction eId="sec.introduction">

        <panel eId="panel.composition">
          <judge eId="panel.j1"
                 refersTo="#person.vesnaGazdic"
                 role="singleJudge"/>
          <clerk eId="panel.c1"
                 refersTo="#person.katarinaRistic"/>
        </panel>

        <p eId="sec.introduction.p1">
          <ref href="#org.osnovniSudHercegNovi">Osnovni sud u Herceg Novom</ref>,
          sudija <ref href="#person.vesnaGazdic">Vesna Gazdić</ref>,
          uz učešće zapisničarke
          <ref href="#person.katarinaRistic">Katarine Ristić</ref>,
          po optužnom predlogu ODT Herceg Novi,
          protiv <party eId="party.accused"
                 refersTo="#person.VM"
                 role="accused">V. M.</party>,
          zbog dva krivična djela nedavanje izdržavanja iz
          <ref href="#law.KZCG">čl. 221 st. 1 Krivičnog zakonika CG</ref>,
          donio je:
        </p>

      </introduction>

      <!-- IZREKA -->
      <decision eId="sec.decision">

        <article eId="sec.decision.guilt">
          <heading>Okrivljeni</heading>
          <p eId="sec.decision.guilt.p1">
            <ref href="#person.VM">V. M.</ref> oglašava se krivim
            zbog dva krivična djela nedavanje izdržavanja iz
            <ref href="#law.KZCG">čl. 221 st. 1 Krivičnog zakonika Crne Gore</ref>.
          </p>
        </article>

        <article eId="sec.decision.sanction">
          <heading>Krivična sankcija</heading>
          <p eId="sec.decision.sanction.p1">
            Izriče se uslovna osuda kojom se utvrđuje jedinstvena kazna zatvora
            u trajanju od 40 dana, sa rokom provjeravanja od 1 godine.
          </p>
        </article>

        <article eId="sec.decision.compensation">
          <heading>Imovinskopravna obaveza</heading>
          <p eId="sec.decision.compensation.p1">
            Okrivljeni je dužan da zakonskoj zastupnici oštećenih
            <ref href="#person.VA">V. A.</ref>,
            isplati iznos od 1.650,00 eura.
          </p>
        </article>

        <article eId="sec.decision.costs">
          <heading>Troškovi postupka</heading>
          <p eId="sec.decision.costs.p1">
            Okrivljeni se obavezuje da naknadi troškove krivičnog postupka
            u iznosu od 66,00 eura i troškove paušala u iznosu od 30,00 eura.
          </p>
        </article>

      </decision>

      <!-- OBRAZLOŽENJE -->
      <motivation eId="sec.motivation">

        <section eId="sec.motivation.legal">
          <heading>Pravna kvalifikacija</heading>
          <p eId="sec.motivation.legal.p1">
            Obrazloženje je izostalo na osnovu
            <ref href="#law.ZKP">čl. 458 st. 7 ZKP-a</ref>,
            jer su se stranke odrekle prava žalbe i ne zahtjevaju pisani otpravak presude.
          </p>
        </section>

      </motivation>

