    <body eId="body">

      <header eId="header">
        <p eId="header.p1">U IME CRNE GORE</p>
      </header>

      <!-- SASTAV SUDA -->
      <introduction eId="sec.introduction">

        <panel eId="panel.composition">
          <judge eId="panel.j1"
                 refersTo="#person.ivanDosljak"
                 role="singleJudge"/>
          <clerk eId="panel.c1"
                 refersTo="#person.momirkaFatic"/>
        </panel>

        <p eId="sec.introduction.p1">
          <ref href="#org.osnovniSudBerane">Osnovni sud u Beranama</ref>,
          sudija <ref href="#person.ivanDosljak">Došljak V. Ivan</ref>,
          uz učešće zapisničarke
          <ref href="#person.momirkaFatic">Fatić Momirke</ref>,
          u krivičnom predmetu protiv
          <party eId="party.accused"
                 refersTo="#person.MV"
                 role="accused">M. V.</party>,
          po optužnom predlogu ODT,
          u prisustvu zastupnice optužbe
          <party eId="party.prosecutor"
                 refersTo="#person.advokaticaDM"
                 role="prosecutor"/>,
          dana 16.10.2024. godine donio je:
        </p>

      </introduction>

      <!-- IZREKA -->
      <decision eId="sec.decision">

        <article eId="sec.decision.guilt">
          <heading>Okrivljeni</heading>
          <p eId="sec.decision.guilt.p1">
            <ref href="#person.MV">M. V.</ref> oglašava se krivim
            zbog dva krivična djela
            nedavanje izdržavanja iz <ref href="#art_221__para_1">čl. 221 st. 1</ref>
            <ref href="#law.KZCG">Krivičnog zakonika Crne Gore</ref>.
          </p>
        </article>

        <article eId="sec.decision.sanction">
          <heading>Krivična sankcija</heading>
          <p eId="sec.decision.sanction.p1">
            Izriče se jedinstvena novčana kazna u iznosu od 1.600,00 eura,
            koju je dužan platiti u roku od 3 mjeseca od dana pravosnažnosti presude.
          </p>
          <p eId="sec.decision.sanction.p2">
            Ukoliko se jedinstvena novčana kazna ne plati u naznačenom roku,
            ista će se zamijeniti kaznom zatvora,
            računajući za svakih započetih 25,00 eura novčane kazne kao 1 dan zatvora.
          </p>
        </article>

        <article eId="sec.decision.costs">
          <heading>Troškovi postupka</heading>
          <p eId="sec.decision.costs.p1">
            Okrivljeni je dužan da na ime troškova krivičnog postupka - paušala
            isplati novčani iznos od 30,00 eura u korist budžeta Crne Gore,
            na žiro račun broj 832 - 150 - 38, u roku od 15 dana od dana pravosnažnosti presude,
            pod prijetnjom prinudnog izvršenja.
          </p>
        </article>

      </decision>

      <!-- OBRAZLOŽENJE -->
      <motivation eId="sec.motivation">

        <section eId="sec.motivation.facts">
          <heading>Utvrđeno činjenično stanje</heading>
          <p eId="sec.motivation.facts.p1">
            Sud je utvrdio da okrivljeni u periodu
            24.11.2023–29.06.2024.
            nije davao izdržavanje za svoju maloljetnu djecu
            <ref href="#person.MA">M. A.</ref> i <ref href="#person.MB">M. B.</ref>,
            iako je ta obaveza utvrđena
            pravosnažnom presudom.
          </p>
        </section>

        <section eId="sec.motivation.legal">
          <heading>Pravna kvalifikacija</heading>
          <p eId="sec.motivation.legal.p1">
            Radnjama okrivljenog ostvarena su sva obilježja
            krivičnog djela iz <ref href="#art_221__para_1">čl. 221 st. 1</ref>
            <ref href="#law.KZCG">KZ CG</ref>.
          </p>
        </section>

        <section eId="sec.motivation.sanction">
          <heading>Odluka o kazni</heading>
          <p eId="sec.motivation.sanction.p1">
            Kao olakšavajuće okolnosti sud je cijenio
            siromašno imovno stanje i činjenicu da je otac troje djece,
            dok je kao otežavajuća okolnost cijenjena njegova ranija osuđivanost.
          </p>
        </section>

      </motivation>

