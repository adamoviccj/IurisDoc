    <body eId="body">

      <header eId="header">
        <p eId="header.p1">U IME CRNE GORE</p>
      </header>

      <!-- SASTAV SUDA -->
      <introduction eId="sec.introduction">

        <panel eId="panel.composition">
          <judge eId="panel.j1"
                 refersTo="#person.branislavLekovic"
                 role="singleJudge"/>
          <clerk eId="panel.c1"
                 refersTo="#person.aleksandraMartinovic"/>
        </panel>

        <p eId="sec.introduction.p1">
          <ref href="#org.osnovniSudCetinje">Osnovni sud u Cetinju</ref>,
          sudija <ref href="#person.branislavLekovic">Branislav Leković</ref>,
          uz učešće zapisničarke
          <ref href="#person.aleksandraMartinovic">Aleksandre Martinović</ref>,
          u krivičnom predmetu protiv
          <party eId="party.accused"
                 refersTo="#person.SV"
                 role="accused">S. V.</party>,
          po optužnom predlogu ODT,
          u prisustvu zastupnice optužbe
          <party eId="party.prosecutor"
                 refersTo="#person.jelenaBlecić"
                 role="prosecutor"/>,
          dana 10.09.2024. godine donio je:
        </p>

      </introduction>

      <!-- IZREKA -->
      <decision eId="sec.decision">

        <article eId="sec.decision.guilt">
          <heading>Okrivljeni</heading>
          <p eId="sec.decision.guilt.p1">
            <ref href="#person.SV">S. V.</ref> oglašava se krivim
            zbog četiri krivična djela
            nedavanje izdržavanja iz <ref href="#art_221__para_1">čl. 221 st. 1</ref>
            <ref href="#law.KZCG">Krivičnog zakonika Crne Gore</ref>.
          </p>
        </article>

        <article eId="sec.decision.sanction">
          <heading>Krivična sankcija</heading>
          <p eId="sec.decision.sanction.p1">
            Na jedinstvenu kaznu zatvora u trajanju od 100 (stotinu) dana,
            koja će se izvršiti tako što će okrivljeni istu izdržavati
            u prostorijama u kojima stanuje.
          </p>
        </article>

        <article eId="sec.decision.compensation">
          <heading>Obaveza izdržavanja</heading>
          <p eId="sec.decision.compensation.p1">
            Obavezuje se okrivljeni da zakonskoj zastupnici maloljetnih oštećenih
            S. V., S. J., S. M. i S. V., uredno daje izdržavanje.
          </p>
        </article>

        <article eId="sec.decision.costs">
          <heading>Troškovi postupka</heading>
          <p eId="sec.decision.costs.p1">
            Okrivljeni je dužan da plati na ime troškova krivičnog postupka
            iznos od 137,50 eura, u roku od 15 dana po pravosnažnosti presude,
            pod prijetnjom prinudnog izvršenja.
          </p>
        </article>

      </decision>

      <!-- OBRAZLOŽENJE -->
      <motivation eId="sec.motivation">

        <section eId="sec.motivation.facts">
          <heading>Utvrđeno činjenično stanje</heading>
          <p eId="sec.motivation.facts.p1">
            Sud je utvrdio da okrivljeni u vremenskom periodu od .... godine do .... godine
            nije redovno davao izdržavanje za svoju maloljetnu djecu S. V., S. J., S. M. i S. V.,
            u ukupnom iznosu i na način kako je to određeno izvršnom presudom.
          </p>
        </section>

        <section eId="sec.motivation.legal">
          <heading>Pravna kvalifikacija</heading>
          <p eId="sec.motivation.legal.p1">
            Radnjama okrivljenog ostvarena su sva obilježja
            krivičnog djela iz <ref href="#art_221__para_1">čl. 221 st. 1</ref>
            <ref href="#law.KZCG">KZ CG</ref>.
          </p>
        </section>

        <section eId="sec.motivation.sanction">
          <heading>Odluka o kazni</heading>
          <p eId="sec.motivation.sanction.p1">
            Sud je cijenio sve okolnosti koje utiču na izbor i visinu kazne,
            te je kao olakšavajuće okolnosti uzeo u obzir da se oštećena nije pridružila
            krivičnom gonjenju, dok je od otežavajućih okolnosti cijenio raniju osuđivanost.
          </p>
        </section>

      </motivation>

