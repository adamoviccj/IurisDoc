    <body eId="body">

      <header eId="header">
        <p eId="header.p1">U IME CRNE GORE</p>
      </header>

      <!-- SASTAV SUDA -->
      <introduction eId="sec.introduction">

        <panel eId="panel.composition">
          <judge eId="panel.j1"
                 refersTo="#person.tamaraSpasojevic"
                 role="singleJudge"/>
          <clerk eId="panel.c1"
                 refersTo="#person.anaStanisic"/>
        </panel>

        <p eId="sec.introduction.p1">
          <ref href="#org.osnovniSudBar">Osnovni sud u Baru</ref>,
          sudija <ref href="#person.tamaraSpasojevic">Tamara Spasojević</ref>,
          uz učešće zapisničarke
          <ref href="#person.anaStanisic">Ane Stanišić</ref>,
          u krivičnom predmetu protiv
          <party eId="party.accused"
                 refersTo="#person.MK"
                 role="accused">M. K.</party>,
          po optužnom predlogu ODT,
          u prisustvu zastupnika optužbe
          <party eId="party.prosecutor"
                 refersTo="#person.SB"
                 role="prosecutor"/>,
          dana 09.04.2024. godine donio je:
        </p>

      </introduction>

      <!-- IZREKA -->
      <decision eId="sec.decision">

        <article eId="sec.decision.guilt">
          <heading>Okrivljeni</heading>
          <p eId="sec.decision.guilt.p1">
            <ref href="#person.MK">M. K.</ref> oglašava se krivim
            zbog dva krivična djela
            nedavanje izdržavanja iz <ref href="#art_221__para_1">čl. 221 st. 1</ref>
            <ref href="#law.KZCG">Krivičnog zakonika Crne Gore</ref>.
          </p>
        </article>

        <article eId="sec.decision.sanction">
          <heading>Krivična sankcija</heading>
          <p eId="sec.decision.sanction.p1">
            Izriče se jedinstvena novčana kazna u iznosu od 400,00 eura,
            koju kaznu je dužan da plati u roku od 3 mjeseca od dana pravosnažnosti presude,
            pod prijetnjom izvršenja.
          </p>
        </article>

        <article eId="sec.decision.compensation">
          <heading>Imovinskopravna obaveza</heading>
          <p eId="sec.decision.compensation.p1">
            Okrivljeni je dužan da na ime dospjelih obaveza na ime izdržavanja
            malodobnih A. K. i B. K., zakonskoj zastupnici
            <ref href="#person.ASK">A. S. K.</ref> isplati iznos od 1.706,25 eura
            koje je dužan da isplati u roku od 15 dana od dana pravosnažnosti presude
            pod prijetnjom prinudnog izvršenja.
          </p>
        </article>

        <article eId="sec.decision.costs">
          <heading>Troškovi postupka</heading>
          <p eId="sec.decision.costs.p1">
            Okrivljeni je dužan da plati troškove krivičnog postupka
            u iznosu od 82,50 eura, kao i sudski paušal
            u iznosu od 50,00 eura,
            shodno <ref href="#art_229">čl. 229</ref>
            <ref href="#law.ZKP">ZKP</ref>.
          </p>
        </article>

      </decision>

      <!-- OBRAZLOŽENJE -->
      <motivation eId="sec.motivation">

        <section eId="sec.motivation.facts">
          <heading>Utvrđeno činjenično stanje</heading>
          <p eId="sec.motivation.facts.p1">
            Sud je utvrdio da okrivljeni u periodu
            05.06.2022–05.02.2024.
            nije davao izdržavanje za svoju maloljetnu djecu
            A. K. i B. K.,
            iako je ta obaveza utvrđena
            pravosnažnom presudom.
          </p>
        </section>

        <section eId="sec.motivation.legal">
          <heading>Pravna kvalifikacija</heading>
          <p eId="sec.motivation.legal.p1">
            Radnjama okrivljenog ostvarena su sva obilježja
            krivičnog djela iz <ref href="#art_221__para_1">čl. 221 st.1</ref>
            <ref href="#law.KZCG">KZ CG</ref>.
          </p>
        </section>

        <section eId="sec.motivation.sanction">
          <heading>Odluka o kazni</heading>
          <p eId="sec.motivation.sanction.p1">
            Kao olakšavajuće okolnosti sud je cijenio
            raniju neosuđivanost i porodične prilike.
          </p>
        </section>

      </motivation>

