    <body eId="body">

      <header eId="header">
        <p eId="header.p1">U IME CRNE GORE</p>
      </header>

      <!-- SASTAV SUDA -->
      <introduction eId="sec.introduction">

        <panel eId="panel.composition">
          <judge eId="panel.j1"
                 refersTo="#person.marijaCupic"
                 role="singleJudge"/>
          <clerk eId="panel.c1"
                 refersTo="#person.sanjaAbramovic"/>
        </panel>

        <p eId="sec.introduction.p1">
          <ref href="#org.osnovniSudCetinje">Osnovni sud u Cetinju</ref>,
          sudija <ref href="#person.marijaCupic">Marija Ćupić</ref>,
          uz učešće zapisničarke
          <ref href="#person.sanjaAbramovic">Sanje Abramović</ref>,
          u krivičnom predmetu protiv
          <party eId="party.accused"
                 refersTo="#person.MS"
                 role="accused">M. S.</party>,
          po optužnom predlogu ODT,
          u prisustvu zastupnice optužbe
          <party eId="party.prosecutor"
                 refersTo="#person.jelenaBlecić"
                 role="prosecutor"/>,
          dana 11.04.2024. godine donio je:
        </p>

      </introduction>

      <!-- IZREKA -->
      <decision eId="sec.decision">

        <article eId="sec.decision.guilt">
          <heading>Okrivljeni</heading>
          <p eId="sec.decision.guilt.p1">
            <ref href="#person.MS">M. S.</ref> oglašava se krivim
            zbog krivičnog djela
            nedavanje izdržavanja iz člana 221 stav 1
            <ref href="#law.KZCG">Krivičnog zakonika Crne Gore</ref>.
          </p>
        </article>

        <article eId="sec.decision.sanction">
          <heading>Krivična sankcija</heading>
          <p eId="sec.decision.sanction.p1">
            Izriče se uslovna osuda kojom se utvrđuje kazna zatvora
            u trajanju od 60 dana,
            sa rokom provjeravanja od 1 godine.
          </p>
        </article>

        <article eId="sec.decision.compensation">
          <heading>Imovinskopravna obaveza</heading>
          <p eId="sec.decision.compensation.p1">
            Okrivljeni je dužan da oštećenoj
            <party eId="party.victim"
                   refersTo="#person.MJ"
                   role="victim">mldb. M. J.</party>,
            preko zakonske zastupnice
            <ref href="#person.BM">B. M.</ref>,
            isplati iznos od 1.313,33 eura.
          </p>
        </article>

        <article eId="sec.decision.costs">
          <heading>Troškovi postupka</heading>
          <p eId="sec.decision.costs.p1">
            Okrivljeni je dužan da plati troškove postupka
            u iznosu od 55,00 eura i sudski paušal
            u iznosu od 50,00 eura,
            shodno čl. 226 i 229
            <ref href="#law.ZKP">ZKP</ref>.
          </p>
        </article>

      </decision>

      <!-- OBRAZLOŽENJE -->
      <motivation eId="sec.motivation">

        <section eId="sec.motivation.facts">
          <heading>Utvrđeno činjenično stanje</heading>
          <p eId="sec.motivation.facts.p1">
            Sud je utvrdio da okrivljeni u periodu
            26.04.2021–20.06.2022.
            nije davao izdržavanje za svoju kćerku
            <ref href="#person.MJ">M. J.</ref>,
            iako je ta obaveza utvrđena
            pravosnažnom presudom.
          </p>
        </section>

        <section eId="sec.motivation.legal">
          <heading>Pravna kvalifikacija</heading>
          <p eId="sec.motivation.legal.p1">
            Radnjama okrivljenog ostvarena su sva obilježja
            krivičnog djela iz čl. 221 st.1
            <ref href="#law.KZCG">KZ CG</ref>.
          </p>
        </section>

        <section eId="sec.motivation.sanction">
          <heading>Odluka o kazni</heading>
          <p eId="sec.motivation.sanction.p1">
            Kao olakšavajuće okolnosti sud je cijenio
            raniju neosuđivanost i porodične prilike.
          </p>
        </section>

      </motivation>

      <!-- POTPIS -->
